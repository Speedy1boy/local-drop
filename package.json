{
  "name": "local-drop-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=shared",
    "db:up": "docker compose up db -d",
    "db:down": "docker compose stop db",
    "front": "npm run start --workspace=frontend",
    "back": "npm run start:dev --workspace=backend",
    "dev": "concurrently \"npm run back\" \"npm run front\"",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}