{
  "name": "local-drop-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "start:front": "npm run start --workspace=frontend",
    "start:back": "npm run start:dev --workspace=backend",
    "dev": "concurrently \"npm run start:back\" \"npm run start:front\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
