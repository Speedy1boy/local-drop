generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClipboardItem {
  id        String   @id @default(uuid())
  content   String
  type      String   @default("text")
  createdAt DateTime @default(now())
}

model NoteItem {
  id        String   @id @default(uuid())
  title     String
  content   String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FileItem {
  id           String   @id @default(uuid())
  originalName String
  fileName     String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  folderId     String?
  folder       FolderItem? @relation(fields: [folderId], references: [id], onDelete: Cascade)
}

model FolderItem {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  parent    FolderItem?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  FolderItem[] @relation("FolderHierarchy")
  files     FileItem[]
  createdAt DateTime @default(now())
}

model SystemSetting {
  key   String @id
  value String
}

model DeviceSession {
  id           String   @id @default(uuid())
  ip           String
  userAgent    String
  role         String   @default("guest")
  tokenVersion Int
  createdAt    DateTime @default(now())
  lastActive   DateTime @default(now())
}

model SecurityLog {
  id        String   @id @default(uuid())
  ip        String
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model BlockedIp {
  ip        String   @id
  reason    String
  userAgent String?
  createdAt DateTime @default(now())
}